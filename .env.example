# Everything here is optional. With no .env at all, `npm start` runs the full
# dashboard on an in-memory catalog with deterministic (non-LLM) reasoning.

# ── Data backend ──────────────────────────────────────────────────────────────
# memory = no database required (default). db = Postgres, falls back to memory
# if unreachable.
DATA_BACKEND=memory
# DATABASE_URL=postgresql+asyncpg://scuser:scpassword@localhost:5432/supplychain

# ── LLM provider ──────────────────────────────────────────────────────────────
# none | ollama | gemini | openai | anthropic
# "none" costs nothing and needs no network: recommendations come from the
# simulation itself. Any other provider only rewrites the prose - the numbers
# always come from the Monte Carlo run, never from the model.
LLM_PROVIDER=none
# LLM_MODEL=                       # blank uses the provider default

# Local models, no API key, nothing leaves the machine:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Google Gemini:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_MODEL=gemini-2.0-flash

# Any OpenAI-compatible endpoint (OpenAI, Groq, Together, vLLM, LM Studio):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Anthropic:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5

# Air-gapped: forces LLM_PROVIDER=ollama regardless of the setting above.
SOVEREIGN_MODE=false

# ── Agent engine ──────────────────────────────────────────────────────────────
# false = built-in async pipeline (default, no extra packages).
# true  = LangGraph, which adds durable Postgres checkpointing so a 48h approval
#         window survives a restart. Requires: pip install langgraph
USE_LANGGRAPH=false

# ── Ingestion (optional; disabled without keys) ───────────────────────────────
ENABLE_INGESTION=false
# NEWSAPI_KEY=
# OPENWEATHERMAP_API_KEY=
# COMTRADE_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Simulation ────────────────────────────────────────────────────────────────
DEFAULT_MC_ITERATIONS=1000
MAX_MC_ITERATIONS=50000

# ── Governance ────────────────────────────────────────────────────────────────
AUTO_APPROVE_COST_THRESHOLD_USD=10000
DEFAULT_APPROVAL_TIMEOUT_HOURS=24
